# 本地开发依赖凭据模板：复制为 deploy/.env 后替换所有占位值再启动。
# 生成强凭据：openssl rand -base64 24；主密钥：openssl rand -base64 32。
# deploy/.env 已被 .gitignore 拦截，不得提交到版本库。

POSTGRES_DB=faceservice
POSTGRES_USER=faceservice
POSTGRES_PASSWORD=please-replace
POSTGRES_PORT=5432

REDIS_PASSWORD=please-replace
REDIS_PORT=16379

MASTER_KEY=please-replace

RUSTFS_ACCESS_KEY=please-replace
RUSTFS_SECRET_KEY=please-replace
