{
  "name": "identity-verification-frontend",
  "version": "0.1.0",
  "description": "React frontend for the identity verification platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check:routes": "bun scripts/check-routes.ts",
    "generate:narration": "bun scripts/generate-narration.ts",
    "generate:keyboard-fx": "bun scripts/generate-keyboard-fx.ts",
    "generate:all-audio": "bun scripts/generate-keyboard-fx.ts && bun scripts/generate-narration.ts",
    "render:demo": "bunx remotion render src/remotion/index.ts DeveloperIntegrationDemo out/developer-integration-demo.mp4 --props='{\"narration\":true}'",
    "test": "vitest run",
    "generate:bgmusic": "bun scripts/generate-bgmusic.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@heroicons/react": "^2.2.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@remotion/google-fonts": "^4.0.545",
    "@tanstack/react-query": "^5.108.0",
    "antd": "^6.7.1",
    "axios": "^1.21.1",
    "html-to-image": "^1.11.13",
    "i18next": "^27.2.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.545",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  }
}
